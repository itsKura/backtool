# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.

# --- Market data ---
# Public Binance klines endpoints need no authentication, so these are optional
# for V1. They are here so the shape of the config is defined up front.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Base URL for Binance REST.
#
# Leave this COMMENTED OUT unless you have a reason not to. The code default is
# https://data-api.binance.vision -- Binance's public market-data mirror, which
# serves the identical /api/v3/klines contract and is not geo-restricted.
#
# api.binance.com returns HTTP 451 (unavailable for legal reasons) from a number
# of jurisdictions. Setting it here would override the working default and break
# every fetch.
# BINANCE_BASE_URL=https://data-api.binance.vision

# --- CPI release figures (BLS) ---
# `backtool refresh-cpi` fills the actual and previous columns of the release
# file from the Bureau of Labor Statistics' public series CUUR0000SA0, which is
# the measure this project studies: headline CPI-U, all items, year-over-year,
# not seasonally adjusted.
#
# OPTIONAL. The API answers without a key, at 25 requests a day over 10 years of
# history -- ample for a command run once a month. A free key from
# https://data.bls.gov/registrationEngine/ raises that to 500 a day over 20
# years, which is only worth it if you want to backfill further than 10 years.
#
# It supplies no consensus. That figure is a survey of economists sold by
# Reuters, Bloomberg and Dow Jones; no agency publishes it, so the consensus
# column stays hand-transcribed and the refresh never touches it.
BLS_API_KEY=

# --- Local storage ---
# Root directory for the SQLite candle cache. Relative paths resolve from the
# repository root.
BACKTOOL_DATA_DIR=data

# --- Logging ---
BACKTOOL_LOG_LEVEL=INFO

# --- AI layer (Milestone 5 — not used yet) ---
ANTHROPIC_API_KEY=
