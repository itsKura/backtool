# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.

# --- Market data ---
# Public Binance klines endpoints need no authentication, so these are optional
# for V1. They are here so the shape of the config is defined up front.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Base URL for Binance REST. Override if you need a regional mirror
# (e.g. https://api-gcp.binance.com) or a testnet.
BINANCE_BASE_URL=https://api.binance.com

# --- Local storage ---
# Root directory for the Parquet candle cache. Relative paths resolve from the
# repository root.
BACKTOOL_DATA_DIR=data

# --- Logging ---
BACKTOOL_LOG_LEVEL=INFO

# --- AI layer (Milestone 5 — not used yet) ---
ANTHROPIC_API_KEY=
