# --- Secrets: never commit these ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# --- Local market-data cache (regenerable, potentially large) ---
# A leading slash anchors this to the repository root. Without it, the pattern
# would also match src/backtool/events/data/, silently excluding the FOMC
# calendar from version control. Ignore the *contents*, not the directory
# itself, so the .gitkeep exception below can take effect.
/data/*
!/data/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# --- Tooling ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Editors / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini

# Assistant and editor tooling. Local to whoever is working on the project and
# specific to their machine -- the launch config here hardcodes a Windows
# interpreter path -- so it is not a fact about the project. Everything the
# project needs to run is in pyproject.toml and `backtool serve`.
.claude/
.cursor/
.aider*
.continue/
.windsurf/

# --- Generated reports (regenerable from a spec fingerprint) ---
/reports/

# Token usage written by the live planner suites. A measurement of one run,
# not a fact about the project.
planner-usage.jsonl

# Dev-server output, written when the app is started by hand.
.server-*.log
